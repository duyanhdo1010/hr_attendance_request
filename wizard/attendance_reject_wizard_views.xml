<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_attendance_reject_wizard_form" model="ir.ui.view">
        <field name="name">attendance.reject.wizard.form</field>
        <field name="model">attendance.reject.wizard</field>
        <field name="arch" type="xml">
            <form string="Lý do từ chối">
                <group>
                    <field name="request_id" invisible="1"/>
                    <field name="reason" placeholder="Nhập lý do từ chối vào đây..."/>
                </group>
                <footer>
                    <button name="action_confirm_reject" string="Xác nhận" type="object" class="btn-danger"/>
                    <button string="Hủy bỏ" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>