<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="rule_attendance_request_employee" model="ir.rule">
            <field name="name">Employee sees own, PM, DL requests</field>
            <field name="model_id" ref="model_attendance_request"/>
            <field name="domain_force">['|', '|', ('employee_id.user_id', '=', user.id), ('pm_id.user_id', '=', user.id), ('dl_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="rule_attendance_request_hr" model="ir.rule">
            <field name="name">HR sees all requests</field>
            <field name="model_id" ref="model_attendance_request"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('hr.group_hr_user'))]"/>
        </record>
    </data>
</odoo>