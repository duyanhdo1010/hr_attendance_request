<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- TREE VIEW -->
    <record id="view_attendance_request_tree" model="ir.ui.view">
        <field name="name">attendance.request.tree</field>
        <field name="model">attendance.request</field>
        <field name="arch" type="xml">
            <tree string="Forgot Attendance Requests" decoration-danger="state not in ('approved', 'rejected') and deadline_date != False and deadline_date &lt; current_date">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="request_date"/>
                <field name="deadline_date"/>
                <field name="pm_id"/>
                <field name="dl_id"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <!-- FORM VIEW -->
    <record id="view_attendance_request_form" model="ir.ui.view">
        <field name="name">attendance.request.form</field>
        <field name="model">attendance.request</field>
        <field name="arch" type="xml">
            <form string="Forgot Attendance Request">
                <header>
                    <button name="action_submit" string="Submit Request" type="object" class="oe_highlight" attrs="{'invisible': [('state', '!=', 'draft')]}"/>
                    <button name="action_approve" string="Approve" type="object" class="btn-success" attrs="{'invisible': [('state', 'not in', ('pm_approve', 'dl_approve', 'hr_approve'))]}"/>
                    <button name="action_reject" string="Reject" type="object" class="btn-danger" attrs="{'invisible':[('state', 'not in', ('pm_approve', 'dl_approve', 'hr_approve'))]}"/>
                    <button name="action_reset_to_draft" string="Reset to Draft" type="object" attrs="{'invisible': [('state', 'not in', ('rejected', 'approved'))]}"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,pm_approve,dl_approve,hr_approve,approved"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="employee_id" attrs="{'readonly':[('state', '!=', 'draft')]}"/>
                            <field name="department_id"/>
                            <field name="deadline_date" readonly="1"/>
                            <field name="pm_id" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                            <field name="dl_id" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                        </group>
                        <group>
                            <field name="request_date" attrs="{'readonly':[('state', '!=', 'draft')]}"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Attendance Request Lines" name="lines">
                            <field name="line_ids" attrs="{'readonly':[('state', '!=', 'draft')]}">
                                <tree editable="bottom">
                                    <field name="forget_type"/>
                                    <field name="work_overnight"/>

                                    <field name="request_checkin" attrs="{'readonly':[('forget_type', '=', 'check_out')]}"/>
                                    <field name="request_checkout" attrs="{'readonly': [('forget_type', '=', 'check_in')]}"/>
                                    <field name="request_checkout_overnight" attrs="{'readonly': [('work_overnight', '=', False)]}"/>

                                    <field name="actual_checkin"/>
                                    <field name="actual_checkout"/>
                                    <field name="reason"/>

                                    <field name="evidence" filename="evidence_name" widget="binary"/>
                                    <field name="evidence_name" invisible="1"/>

                                    <field name="late_approve"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                    <group>
                        <field name="note" attrs="{'readonly':[('state', '!=', 'draft')]}"/>
                    </group>
                    <group>
                        <field name="commit_checkbox" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="activity_ids" widget="mail_activity"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <!-- SEARCH VIEW -->
    <record id="view_attendance_request_search" model="ir.ui.view">
        <field name="name">attendance.request.search</field>
        <field name="model">attendance.request</field>
        <field name="arch" type="xml">
            <search string="Search Requests">
                <field name="name"/>
                <field name="employee_id"/>
                <filter string="Draft" name="filter_draft" domain="[('state', '=', 'draft')]"/>
                <group expand="0" string="Group By">
                    <filter string="Employee" name="group_by_employee" context="{'group_by': 'employee_id'}"/>
                    <filter string="Status" name="group_by_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ACTION & MENU -->
    <record id="action_attendance_request" model="ir.actions.act_window">
        <field name="name">Forgot Attendance</field>
        <field name="res_model">attendance.request</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_attendance_request_root" name="Forgot Attendance" sequence="10"/>
    <menuitem id="menu_attendance_request_action" name="Request List" parent="menu_attendance_request_root" action="action_attendance_request" sequence="10"/>
</odoo>